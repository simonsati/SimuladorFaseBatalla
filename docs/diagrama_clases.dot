digraph Diagrama {
  graph [rankdir=BT, newrank=true, splines=true, nodesep=0.4, ranksep=0.7, fontname="DejaVu Sans", fontsize=22,
         label=<<B>Simulador de la Fase de Batalla · Yu-Gi-Oh! — Diagrama de clases</B><BR/><FONT POINT-SIZE="13">Arquitectura MVC · paquete co.edu.uao.yugioh · simonsati</FONT>>, labelloc=t, pad=0.4];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  subgraph cluster_modelo {
    label=<<B>co.edu.uao.yugioh.modelo</B>>; fontsize=14; style="rounded,filled"; fillcolor="#fbfbfb"; color="#90a4ae";
    "Carta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><I><B>Carta</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ LONGITUD_MAXIMA_NOMBRE: int = 40 {readOnly}</U><BR ALIGN="LEFT"/><U>- cartasCreadas: int = 0</U><BR ALIGN="LEFT"/>- id: int {readOnly}<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+ tipoDeCarta(): String</I><BR ALIGN="LEFT"/><U># validarNombre(nombre: String): String</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Monstruo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><I><B>Monstruo</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ PUNTOS_MINIMOS: int = 0 {readOnly}</U><BR ALIGN="LEFT"/><U>+ PUNTOS_MAXIMOS: int = 5000 {readOnly}</U><BR ALIGN="LEFT"/>- ataque: int<BR ALIGN="LEFT"/>- defensa: int<BR ALIGN="LEFT"/>- posicion: Posicion<BR ALIGN="LEFT"/>- atacoEsteTurno: boolean<BR ALIGN="LEFT"/>- cambioPosicionEsteTurno: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ getAtaque(): int<BR ALIGN="LEFT"/>+ setAtaque(ataque: int): void<BR ALIGN="LEFT"/>+ getDefensa(): int<BR ALIGN="LEFT"/>+ setDefensa(defensa: int): void<BR ALIGN="LEFT"/>+ getPosicion(): Posicion<BR ALIGN="LEFT"/>+ setPosicion(posicion: Posicion): void<BR ALIGN="LEFT"/>+ isAtacoEsteTurno(): boolean<BR ALIGN="LEFT"/>+ isCambioPosicionEsteTurno(): boolean<BR ALIGN="LEFT"/>+ estaEnAtaque(): boolean<BR ALIGN="LEFT"/>+ puedeAtacar(): boolean<BR ALIGN="LEFT"/>+ puedeCambiarPosicion(): boolean<BR ALIGN="LEFT"/>+ getPuntosDePosicion(): int<BR ALIGN="LEFT"/>~ registrarAtaque(): void<BR ALIGN="LEFT"/>~ cambiarPosicion(): void<BR ALIGN="LEFT"/>~ prepararNuevoTurno(): void<BR ALIGN="LEFT"/><I>+ describir(): String</I><BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "MonstruoNormal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>MonstruoNormal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ TIPO: String = "Normal" {readOnly}</U><BR ALIGN="LEFT"/>- descripcion: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ tipoDeCarta(): String<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "MonstruoEfecto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>MonstruoEfecto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ TIPO: String = "Efecto" {readOnly}</U><BR ALIGN="LEFT"/>- efecto: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ MonstruoEfecto(nombre: String, ataque: int, defensa: int,<BR ALIGN="LEFT"/>      posicion: Posicion, efecto: String)<BR ALIGN="LEFT"/>+ tipoDeCarta(): String<BR ALIGN="LEFT"/>+ describir(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Posicion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>Posicion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">ATAQUE<BR ALIGN="LEFT"/>DEFENSA<BR ALIGN="LEFT"/>- etiqueta: String {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ opuesta(): Posicion<BR ALIGN="LEFT"/><U>+ desdeTexto(texto: String): Posicion</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Jugador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>Jugador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ LP_OFICIALES: int = 8000 {readOnly}</U><BR ALIGN="LEFT"/><U>+ MAX_MONSTRUOS_EN_CAMPO: int = 5 {readOnly}</U><BR ALIGN="LEFT"/>- nombre: String {readOnly}<BR ALIGN="LEFT"/>- lpIniciales: int {readOnly}<BR ALIGN="LEFT"/>- puntosVida: int<BR ALIGN="LEFT"/>- campo: ArrayList&lt;Monstruo&gt;<BR ALIGN="LEFT"/>- cementerio: ArrayList&lt;Monstruo&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ recibirDanio(danio: int): int<BR ALIGN="LEFT"/>+ estaDerrotado(): boolean<BR ALIGN="LEFT"/>+ invocar(monstruo: Monstruo): void<BR ALIGN="LEFT"/>+ controla(monstruo: Monstruo): boolean<BR ALIGN="LEFT"/>+ tieneMonstruosEnCampo(): boolean<BR ALIGN="LEFT"/>+ listarMonstruosQuePuedenAtacar(): List&lt;Monstruo&gt;<BR ALIGN="LEFT"/>~ enviarAlCementerio(monstruo: Monstruo): void<BR ALIGN="LEFT"/>~ prepararNuevoTurno(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Duelo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>Duelo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- jugador1: Jugador {readOnly}<BR ALIGN="LEFT"/>- jugador2: Jugador {readOnly}<BR ALIGN="LEFT"/>- historial: HistorialCombate {readOnly}<BR ALIGN="LEFT"/>- registros: ArrayList&lt;RegistroCombate&gt;<BR ALIGN="LEFT"/>- ultimoResultado: ResultadoAtaque<BR ALIGN="LEFT"/>- jugadorEnTurno: Jugador<BR ALIGN="LEFT"/>- turno: int<BR ALIGN="LEFT"/>- ganador: Jugador<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ invocar(duelista: Jugador, monstruo: Monstruo): void<BR ALIGN="LEFT"/>+ atacar(atacante: Monstruo, objetivo: Monstruo): RegistroCombate<BR ALIGN="LEFT"/>+ atacar(atacante: Monstruo): RegistroCombate<BR ALIGN="LEFT"/>+ cambiarPosicion(monstruo: Monstruo): void<BR ALIGN="LEFT"/>+ terminarTurno(): void<BR ALIGN="LEFT"/>+ haTerminado(): boolean<BR ALIGN="LEFT"/>- validarAtacante(atacante: Monstruo): void<BR ALIGN="LEFT"/>- resolver(atacante: Monstruo, objetivo: Monstruo,<BR ALIGN="LEFT"/>      resultado: ResultadoAtaque): RegistroCombate<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CalculadoraDanio" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><B>CalculadoraDanio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ calcular(atacante: Monstruo, defensor: Monstruo): ResultadoAtaque</U><BR ALIGN="LEFT"/><U>+ calcular(atacante: Monstruo): ResultadoAtaque</U><BR ALIGN="LEFT"/><U>- ataqueContraAtaque(atacante: Monstruo, defensor: Monstruo): ResultadoAtaque</U><BR ALIGN="LEFT"/><U>- ataqueContraDefensa(atacante: Monstruo, defensor: Monstruo): ResultadoAtaque</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ResultadoAtaque" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><B>ResultadoAtaque</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- tipo: TipoEnfrentamiento {readOnly}<BR ALIGN="LEFT"/>- danioAlAtacante: int {readOnly}<BR ALIGN="LEFT"/>- danioAlDefensor: int {readOnly}<BR ALIGN="LEFT"/>- atacanteDestruido: boolean {readOnly}<BR ALIGN="LEFT"/>- defensorDestruido: boolean {readOnly}<BR ALIGN="LEFT"/>- descripcion: String {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ huboDanio(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "TipoEnfrentamiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>TipoEnfrentamiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">ATAQUE_VS_ATAQUE<BR ALIGN="LEFT"/>ATAQUE_VS_DEFENSA<BR ALIGN="LEFT"/>ATAQUE_DIRECTO<BR ALIGN="LEFT"/>- etiqueta: String {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ desdeEtiqueta(etiqueta: String): TipoEnfrentamiento</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "RegistroCombate" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>RegistroCombate</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ FORMATO_FECHA: DateTimeFormatter {readOnly}</U><BR ALIGN="LEFT"/>- fechaHora: LocalDateTime {readOnly}<BR ALIGN="LEFT"/>- turno: int {readOnly}<BR ALIGN="LEFT"/>- duelistaAtacante: String {readOnly}<BR ALIGN="LEFT"/>- atacante: String {readOnly}<BR ALIGN="LEFT"/>- duelistaDefensor: String {readOnly}<BR ALIGN="LEFT"/>- defensor: String {readOnly}<BR ALIGN="LEFT"/>- tipo: TipoEnfrentamiento {readOnly}<BR ALIGN="LEFT"/>- danio: int {readOnly}<BR ALIGN="LEFT"/>- afectado: String {readOnly}<BR ALIGN="LEFT"/>- resultado: String {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ esAtaqueDirecto(): boolean<BR ALIGN="LEFT"/>+ equals(otro: Object): boolean<BR ALIGN="LEFT"/>+ hashCode(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "HistorialCombate" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>HistorialCombate</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+ guardar(registro: RegistroCombate): void</I><BR ALIGN="LEFT"/><I>+ cargar(): List&lt;RegistroCombate&gt;</I><BR ALIGN="LEFT"/><I>+ limpiar(): void</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ArchivoHistorial" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>ArchivoHistorial</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ NOMBRE_ARCHIVO: String = "historial_combate.txt" {readOnly}</U><BR ALIGN="LEFT"/><U>+ SEPARADOR: String = " | " {readOnly}</U><BR ALIGN="LEFT"/>- ruta: Path {readOnly}<BR ALIGN="LEFT"/>- lineasDescartadas: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ guardar(registro: RegistroCombate): void<BR ALIGN="LEFT"/>+ cargar(): List&lt;RegistroCombate&gt;<BR ALIGN="LEFT"/>+ limpiar(): void<BR ALIGN="LEFT"/>~ aLinea(registro: RegistroCombate): String<BR ALIGN="LEFT"/>~ desdeLinea(linea: String): RegistroCombate<BR ALIGN="LEFT"/><U>- sanear(texto: String): String</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CatalogoMonstruos" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><FONT POINT-SIZE="10">«final»</FONT><BR/><B>CatalogoMonstruos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ crearMazoDeYugi(): List&lt;Monstruo&gt;</U><BR ALIGN="LEFT"/><U>+ crearMazoDeKaiba(): List&lt;Monstruo&gt;</U><BR ALIGN="LEFT"/><U>+ crearCatalogo(): List&lt;Monstruo&gt;</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ReglaDeBatallaException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>ReglaDeBatallaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR></TABLE>>];
    "PersistenciaException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fff8e1" CELLPADDING="5"><B>PersistenciaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR></TABLE>>];
  }
  subgraph cluster_vista {
    label=<<B>co.edu.uao.yugioh.vista</B>>; fontsize=14; style="rounded,filled"; fillcolor="#fbfbfb"; color="#90a4ae";
    "VentanaDuelo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e8f5e9" CELLPADDING="5"><B>VentanaDuelo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- tabsPrincipal: JTabbedPane<BR ALIGN="LEFT"/>- btnIniciarDuelo, btnInvocar, btnAtacar, ...: JButton<BR ALIGN="LEFT"/>- tblMonstruos, tblCampoJugador1, tblHistorial, ...: JTable<BR ALIGN="LEFT"/>- txtJugador1, txtAtaque, txtDefensa, ...: JTextField<BR ALIGN="LEFT"/>(componentes creados con JFrame Form)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ mostrarInformacion(titulo: String, mensaje: String): void<BR ALIGN="LEFT"/>+ mostrarAdvertencia(titulo: String, mensaje: String): void<BR ALIGN="LEFT"/>+ mostrarError(titulo: String, mensaje: String): void<BR ALIGN="LEFT"/>+ confirmar(titulo: String, mensaje: String): boolean<BR ALIGN="LEFT"/>- initComponents(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_controlador {
    label=<<B>co.edu.uao.yugioh.controlador</B>>; fontsize=14; style="rounded,filled"; fillcolor="#fbfbfb"; color="#90a4ae";
    "ControladorDuelo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e3f2fd" CELLPADDING="5"><B>ControladorDuelo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- vista: VentanaDuelo {readOnly}<BR ALIGN="LEFT"/>- historial: HistorialCombate {readOnly}<BR ALIGN="LEFT"/>- duelo: Duelo<BR ALIGN="LEFT"/>- atacantesDisponibles: ArrayList&lt;Monstruo&gt;<BR ALIGN="LEFT"/>- objetivosDisponibles: ArrayList&lt;Monstruo&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ iniciar(): void<BR ALIGN="LEFT"/>+ actionPerformed(evento: ActionEvent): void<BR ALIGN="LEFT"/>- iniciarDuelo(): void<BR ALIGN="LEFT"/>- invocarMonstruo(): void<BR ALIGN="LEFT"/>- atacar(): void<BR ALIGN="LEFT"/>- cambiarPosicion(): void<BR ALIGN="LEFT"/>- terminarTurno(): void<BR ALIGN="LEFT"/>- cargarHistorial(avisar: boolean): void<BR ALIGN="LEFT"/>- vaciarHistorial(): void<BR ALIGN="LEFT"/>- actualizarVista(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FiltroNumerico" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e3f2fd" CELLPADDING="5"><B>FiltroNumerico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">- maximoDigitos: int {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ aplicar(campo: JTextField, maximoDigitos: int): void</U><BR ALIGN="LEFT"/>+ insertString(fb: FilterBypass, offset: int, texto: String, atributos: AttributeSet): void<BR ALIGN="LEFT"/>+ replace(fb: FilterBypass, offset: int, longitud: int, texto: String, atributos: AttributeSet): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_principal {
    label=<<B>co.edu.uao.yugioh</B>>; fontsize=14; style="rounded,filled"; fillcolor="#fbfbfb"; color="#90a4ae";
    "Main" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#f3e5f5" CELLPADDING="5"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/><U>+ reporteMonstruosPorAtaque(monstruos: List&lt;Monstruo&gt;): String</U><BR ALIGN="LEFT"/><U>+ reporteDanioPorDuelista(registros: List&lt;RegistroCombate&gt;): String</U><BR ALIGN="LEFT"/><U>- imprimirReportes(historial: HistorialCombate): void</U><BR ALIGN="LEFT"/><U>- configurarApariencia(): void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  "JFrame" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#eeeeee" CELLPADDING="5"><FONT POINT-SIZE="10">«javax.swing»</FONT><BR/><B>JFrame</B></TD></TR></TABLE>>];
  "ActionListener" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#eeeeee" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>ActionListener</B></TD></TR></TABLE>>];
  "DocumentFilter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#eeeeee" CELLPADDING="5"><FONT POINT-SIZE="10">«javax.swing.text»</FONT><BR/><B>DocumentFilter</B></TD></TR></TABLE>>];
  "Exception" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#eeeeee" CELLPADDING="5"><FONT POINT-SIZE="10">«java.lang»</FONT><BR/><B>Exception</B></TD></TR></TABLE>>];
  nota [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffde7" COLOR="#b39b2a"><TR><TD ALIGN="LEFT"><B>Notación y criterios del examen</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>subrayado</U> = static · <I>cursiva</I> = abstract · {readOnly} = final · «final» = clase final<BR ALIGN="LEFT"/>Herencia: Carta ← Monstruo ← MonstruoNormal / MonstruoEfecto (dos subclases)<BR ALIGN="LEFT"/>Interfaz implementada: HistorialCombate ← ArchivoHistorial (también ActionListener)<BR ALIGN="LEFT"/>Sobrecarga: Duelo.atacar(...) y CalculadoraDanio.calcular(...)<BR ALIGN="LEFT"/>Sobrescritura: tipoDeCarta() y describir(), métodos de HistorialCombate, equals/hashCode, actionPerformed<BR ALIGN="LEFT"/>Reportes en Main sobre ArrayList / HashMap: reporteMonstruosPorAtaque y reporteDanioPorDuelista<BR ALIGN="LEFT"/>Como pide el enunciado, getters, setters y toString se muestran solo en Monstruo y el único<BR ALIGN="LEFT"/>constructor del diagrama es el de la subclase MonstruoEfecto (en el código las demás clases también los tienen).<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  {rank=same; "MonstruoNormal"; "MonstruoEfecto";}
  "MonstruoEfecto" -> "MonstruoNormal" [style=invis, weight=5];
  {rank=same; "ReglaDeBatallaException"; "PersistenciaException";}
  {rank=same; "Exception"; "Carta"; "Posicion";}
  "Monstruo" -> "Carta" [arrowhead=onormal, arrowsize=1.4, style=solid];
  "MonstruoNormal" -> "Monstruo" [arrowhead=onormal, arrowsize=1.4, style=solid];
  "MonstruoEfecto" -> "Monstruo" [arrowhead=onormal, arrowsize=1.4, style=solid];
